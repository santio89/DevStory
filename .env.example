AUTH_SECRET=
# Legacy — GitHub OAuth (not required for username lookup; kept for future use)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: server-side GitHub API token for username lookups (higher rate limits)
# Create at https://github.com/settings/tokens — public repo read is enough.
GITHUB_TOKEN=

# Optional: enables AI-generated narratives via OpenRouter (falls back to a mock without these)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional: Vercel AI Gateway fallback when OpenRouter fails (https://vercel.com/docs/ai-gateway)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# Database (Neon Postgres — create one at neon.tech or via the Vercel Marketplace)
# App reads DATABASE_URL (falls back to POSTGRES_URL if you use the Vercel integration env names).
DATABASE_URL=
# Unpooled/direct connection, used only by `npm run db:migrate` (optional fallback: DATABASE_URL)
DATABASE_URL_UNPOOLED=

# Email — pick ONE provider.
#
# --- Recommended: Resend + your own domain (no inbox / no personal email) ---
# Resend does NOT work to arbitrary recipients with onboarding@resend.dev (test-only).
# vercel.app subdomains cannot be verified. Buy a domain (~$10/yr), add DNS in Resend.
# You send from noreply@yourdomain.com — no Gmail, no mailbox required.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM=Dev Story <noreply@yourdomain.com>
#
# --- Alternative: EmailJS + connected mail service (e.g. dedicated Gmail) ---
# 1. https://www.emailjs.com → add Email Service (Gmail/SMTP you control)
# 2. Create template — set To: {{to_email}}, Subject: {{subject}}, Body: {{{story_html}}}
# 3. Account → API keys → Public Key + Private Key (private key required for server sends)
# 4. Restrict allowed domains in EmailJS dashboard to your Vercel URL
# EMAIL_PROVIDER=emailjs
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
#
# Auto (default): EmailJS if EMAILJS_* vars set, else Resend if RESEND_API_KEY set.
# EMAIL_PROVIDER=auto

# Public base URL used in emails/share links (e.g. https://yourdevstory.vercel.app)
NEXT_PUBLIC_APP_URL=https://yourdevstory.vercel.app

# Protects server-only cron endpoints (used by scheduled jobs)
CRON_SECRET=
