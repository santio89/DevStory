AUTH_SECRET=
# Legacy — GitHub OAuth (not required for username lookup; kept for future use)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: server-side GitHub API token for username lookups (higher rate limits)
# Create at https://github.com/settings/tokens — public repo read is enough.
GITHUB_TOKEN=

# Optional: enables AI-generated narratives via OpenRouter (falls back to a mock without these)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional: Vercel AI Gateway fallback when OpenRouter fails (https://vercel.com/docs/ai-gateway)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# Database (Neon Postgres — create one at neon.tech or via the Vercel Marketplace)
# App reads DATABASE_URL (falls back to POSTGRES_URL if you use the Vercel integration env names).
DATABASE_URL=
# Unpooled/direct connection, used only by `npm run db:migrate` (optional fallback: DATABASE_URL)
DATABASE_URL_UNPOOLED=

# Email (Resend — https://resend.com). Free tier: 3,000 emails/mo.
RESEND_API_KEY=
# Sender address. Use "onboarding@resend.dev" to test without a domain.
# For production, verify a domain and use something like "Your Dev Story <stories@yourdomain.com>".
RESEND_FROM=Your Dev Story <onboarding@resend.dev>

# Public base URL used in emails/share links (e.g. https://yourdevstory.vercel.app)
NEXT_PUBLIC_APP_URL=https://yourdevstory.vercel.app

# Protects server-only cron endpoints (used by scheduled jobs)
CRON_SECRET=
